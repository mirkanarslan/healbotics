# =====================================================
# HealBotics 3D Video Generator – Umgebungsvariablen
# =====================================================
# Kopiere diese Datei zu ".env" und trage deine API-Keys ein.

# PFLICHT: Anthropic Claude API (Skript-Generierung)
# Erhalte deinen Key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL: ElevenLabs TTS (Deutsche KI-Stimme)
# Erhalte deinen Key: https://elevenlabs.io
# Ohne diesen Key wird ein stiller Placeholder verwendet.
ELEVENLABS_API_KEY=

# OPTIONAL: Runway ML (3D-Video-Generierung)
# Erhalte deinen Key: https://runwayml.com
# Ohne diesen Key wird ein animierter Slideshow-Fallback verwendet.
RUNWAYML_API_KEY=

# Server-Port (Standard: 5000)
PORT=5000
